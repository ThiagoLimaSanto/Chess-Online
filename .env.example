DATABASE_URL=jdbc:mysql://mysql:3306/chess
DATABASE_USERNAME=chess_user
DATABASE_PASSWORD=change-me

MYSQL_DATABASE=chess
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=chess_user
MYSQL_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_NAME=chess-refresh-token
JWT_REFRESH_COOKIE_SAME_SITE=Lax

HTTP_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
